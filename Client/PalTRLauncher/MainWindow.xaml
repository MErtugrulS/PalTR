<Window x:Class="PalTRLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PalTR Launcher"
        Width="1500" Height="920"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowSurfaceBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="NewsCardTemplate">
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,10" Padding="15,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource GoldBrush}" CornerRadius="3" Margin="0,2,0,2" />
                    <StackPanel Grid.Column="1" Margin="13,0,12,0">
                        <TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PublishedAt}" Style="{StaticResource Caption}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NotificationTemplate">
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#C36F5832">
                        <TextBlock Text="!" FontFamily="Georgia" FontWeight="Bold" Foreground="#FFF1D59C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Border Visibility="{Binding IsLauncherVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="0" Background="{StaticResource WindowSurfaceBrush}" BorderBrush="#E0C9A25A"
            BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- Eskitilmiş düşük opaklıklı yüzey dokusu -->
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource OrnamentBrush}" IsHitTestVisible="False" />
            <Ellipse Grid.RowSpan="3" Width="730" Height="730" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-390,-260,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3F2CCDD8" Offset="0" />
                        <GradientStop Color="#00114756" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Üst çerçeve -->
            <Border Grid.Row="0" Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="#B2C9A25A"
                    BorderThickness="0,0,0,1" CornerRadius="17,17,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/paltr-logo.png" Width="70" Height="70" Stretch="Uniform" />
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PALTR LAUNCHER" Style="{StaticResource DisplayTitle}" FontSize="29" />
                            <StackPanel Orientation="Horizontal" Margin="1,4,0,0">
                                <Rectangle Width="48" Height="1" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text=" OYUN VE SUNUCU MERKEZİ " Style="{StaticResource Eyebrow}" />
                                <Rectangle Width="48" Height="1" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#B30B1B22" BorderBrush="#9A7A673D" BorderThickness="1" CornerRadius="9"
                                Padding="13,9" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Snapshot.ServerStatus}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#B70D3E48" BorderBrush="#7049C3CE" BorderThickness="1" CornerRadius="9"
                                Padding="13,9" Margin="0,0,8,0">
                            <TextBlock><Run Text="Aktif Oyuncu  "/><Run Text="{Binding Snapshot.ActivePlayers}" FontWeight="Bold" Foreground="#FF9DEFF2"/><Run Text=" / "/><Run Text="{Binding Snapshot.Capacity}"/></TextBlock>
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Padding="13,9" Margin="0,0,8,0"
                                Command="{Binding SelectPageCommand}" CommandParameter="Bildirimler">
                            <TextBlock><Run Text="Bildirim  "/><Run Text="{Binding Snapshot.NotificationCount}" FontWeight="Bold" Foreground="#FFFFD987"/></TextBlock>
                        </Button>
                        <Button Content="—" Style="{StaticResource GhostButton}" Padding="13,9" Margin="0,0,6,0" Click="Minimize_OnClick" />
                        <Button Content="×" Style="{StaticResource SecondaryButton}" Background="#C16E2D27" BorderBrush="#CE9C6D55"
                                Padding="14,8" FontSize="17" Click="Close_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Değiştirilebilir navigasyon -->
                <Border Grid.Column="0" Background="{StaticResource SidebarSurfaceBrush}" BorderBrush="#745C5033" BorderThickness="0,0,1,0" Padding="17,22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Rectangle Grid.RowSpan="3" Fill="{StaticResource OrnamentBrush}" Opacity="0.22" IsHitTestVisible="False" />
                        <StackPanel>
                            <TextBlock Text="MENÜ" Style="{StaticResource Eyebrow}" Margin="12,0,0,13" />
                            <RadioButton Content="Ana Sayfa" Tag="⌂" Style="{StaticResource NavButton}" GroupName="Navigation"
                                         IsChecked="{Binding IsHomePage, Mode=OneWay}" Command="{Binding SelectPageCommand}" CommandParameter="Ana Sayfa" />
                            <RadioButton Content="Haberler" Tag="▤" Style="{StaticResource NavButton}" GroupName="Navigation"
                                         IsChecked="{Binding IsNewsPage, Mode=OneWay}" Command="{Binding SelectPageCommand}" CommandParameter="Haberler" />
                            <RadioButton Content="Bildirimler" Tag="!" Style="{StaticResource NavButton}" GroupName="Navigation"
                                         IsChecked="{Binding IsNotificationsPage, Mode=OneWay}" Command="{Binding SelectPageCommand}" CommandParameter="Bildirimler" />
                            <RadioButton Content="Destek Merkezi" Tag="?" Style="{StaticResource NavButton}" GroupName="Navigation"
                                         IsChecked="{Binding IsSupportPage, Mode=OneWay}" Command="{Binding SelectPageCommand}" CommandParameter="Destek" />
                            <RadioButton Content="Mağaza" Tag="◆" Style="{StaticResource NavButton}" GroupName="Navigation"
                                         IsChecked="{Binding IsStorePage, Mode=OneWay}" Command="{Binding SelectPageCommand}" CommandParameter="Mağaza" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Border Height="1" Background="#5E7C663A" Margin="7,0,7,14" />
                            <Button Style="{StaticResource AccountShortcutButton}" Command="{Binding SelectPageCommand}" CommandParameter="Hesabım">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HESABIM" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding AccountDisplayName}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,1" />
                                        <TextBlock Text="{Binding Snapshot.Membership}" Foreground="{StaticResource GoldLightBrush}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="{StaticResource CyanBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sayfalar -->
                <Grid Grid.Column="1" Margin="22,20,22,18">
                    <!-- Modern launcher ana sayfası -->
                    <Grid Visibility="{Binding IsHomePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="390"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#E2C9A25A"
                                CornerRadius="13" Padding="2" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                            <Border Background="{StaticResource HeroSurfaceBrush}" CornerRadius="11" ClipToBounds="True">
                            <Grid Background="Transparent" MouseLeftButtonUp="Slider_OnMouseLeftButtonUp">
                                <Image Source="{Binding CurrentSlide.ImagePath}" Stretch="UniformToFill" Opacity="0.86" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F2071722" Offset="0" />
                                            <GradientStop Color="#A80A1D29" Offset="0.46" />
                                            <GradientStop Color="#1407131C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Fill="{StaticResource OrnamentBrush}" Opacity="0.12" IsHitTestVisible="False" />
                                <StackPanel Margin="42" Width="680" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSlide.Category}" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                                    <TextBlock Text="{Binding CurrentSlide.Title}" Style="{StaticResource DisplayTitle}" FontSize="42" TextWrapping="Wrap" Margin="0,13,0,10" />
                                    <TextBlock Text="{Binding CurrentSlide.Summary}"
                                               Style="{StaticResource Caption}" FontSize="16" LineHeight="25" TextWrapping="Wrap" Width="620" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,22,24,0">
                                    <Button Content="‹" Style="{StaticResource GhostButton}" Width="38" Height="38" Padding="0"
                                            FontSize="22" Command="{Binding PreviousSlideCommand}" />
                                    <Border Background="#A307171F" BorderBrush="#5F8C7544" BorderThickness="1" CornerRadius="8"
                                            Padding="12,8" Margin="6,0">
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding CurrentSlideNumber, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                                            <Run Text=" / " /><Run Text="{Binding SlideCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Button Content="›" Style="{StaticResource GhostButton}" Width="38" Height="38" Padding="0"
                                            FontSize="22" Command="{Binding NextSlideCommand}" />
                                </StackPanel>
                            </Grid>
                            </Border>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OrnatePanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#A7115962">
                                        <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="SUNUCU DURUMU" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding Snapshot.ServerStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,18,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftPanel}" Margin="0,0,6,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="AKTİF OYUNCU" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Snapshot.ActivePlayers}" Style="{StaticResource DisplayTitle}" FontSize="44" Foreground="#FF8BE5D6" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SoftPanel}" Margin="6,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="KAPASİTE" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Snapshot.Capacity}" Style="{StaticResource DisplayTitle}" FontSize="44" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="BAĞLANTI" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding Snapshot.ServerAddress}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="CANLI" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Bottom" />
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="SUNUCUYA KATIL" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,5,0" Padding="12,9" Command="{Binding JoinServerCommand}" />
                                    <Button Grid.Column="1" Content="YENİLE" Style="{StaticResource SecondaryButton}"
                                            Margin="5,0,0,0" Padding="12,9" Command="{Binding RefreshCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OrnatePanel}" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Son Haberler" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="PalTR dünyasından güncellemeler" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                                    </StackPanel>
                                    <Button Content="TÜMÜNÜ GÖR" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="12,7" FontSize="11" Command="{Binding SelectPageCommand}" CommandParameter="Haberler" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding News}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="1.08*"/><RowDefinition Height="0.92*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource OrnatePanel}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Hızlı İşlemler" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Grid.Row="1" Margin="0,13,0,0">
                                        <Button Content="GÜNCELLEMELERİ KONTROL ET" Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpdatesCommand}" />
                                        <Button Content="DESTEK TALEBİ OLUŞTUR" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0"
                                                Command="{Binding SelectPageCommand}" CommandParameter="Destek" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource OrnatePanel}" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HESAP" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding Snapshot.AccountName}" Style="{StaticResource DisplayTitle}" FontSize="22" Margin="0,7,0,2" />
                                        <TextBlock Text="{Binding Snapshot.Membership}" Foreground="{StaticResource GoldLightBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="58" Height="58" CornerRadius="29" Background="#A00F5360" BorderBrush="#C2C9A25A" BorderThickness="1">
                                        <TextBlock Text="P" Style="{StaticResource DisplayTitle}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Haberler -->
                    <ScrollViewer Visibility="{Binding IsNewsPage, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                            <TextBlock Text="Haberler ve Güncellemeler" Style="{StaticResource DisplayTitle}" FontSize="31" />
                            <TextBlock Text="Sunucu duyuruları, bakım notları ve launcher sürümleri." Style="{StaticResource Caption}" Margin="0,6,0,22" />
                            <ItemsControl ItemsSource="{Binding News}" ItemTemplate="{StaticResource NewsCardTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bildirimler -->
                    <StackPanel Visibility="{Binding IsNotificationsPage, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="940" HorizontalAlignment="Left">
                        <TextBlock Text="Bildirim Merkezi" Style="{StaticResource DisplayTitle}" FontSize="31" />
                        <TextBlock Text="Hesap, sunucu ve güncelleme bildirimlerin burada toplanır." Style="{StaticResource Caption}" Margin="0,6,0,22" />
                        <Border Style="{StaticResource OrnatePanel}"><ItemsControl ItemsSource="{Binding Notifications}" ItemTemplate="{StaticResource NotificationTemplate}" /></Border>
                    </StackPanel>

                    <!-- Destek -->
                    <Grid Visibility="{Binding IsSupportPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OrnatePanel}" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Destek Merkezi" Style="{StaticResource DisplayTitle}" FontSize="31" />
                                <TextBlock Text="Teknik sorunlar ve hesap talepleri için kayıt oluştur." Style="{StaticResource Caption}" Margin="0,6,0,22" />
                                <TextBlock Text="KONU" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                                <TextBox Text="{Binding SupportSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" />
                                <TextBlock Text="AÇIKLAMA" Style="{StaticResource Eyebrow}" Margin="0,18,0,7" />
                                <TextBox Text="{Binding SupportMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" MinHeight="210"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <Button Content="TALEBİ HAZIRLA" Style="{StaticResource PrimaryButton}" Width="190" HorizontalAlignment="Left" Margin="0,18,0,0"
                                        Command="{Binding SubmitTicketCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OrnatePanel}">
                            <StackPanel>
                                <TextBlock Text="Taleplerim" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding Tickets}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,9">
                                            <StackPanel>
                                                <Grid><TextBlock Text="{Binding Number}" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold"/><TextBlock Text="{Binding State}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}"/></Grid>
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="{Binding UpdatedAt}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mağaza -->
                    <Grid Visibility="{Binding IsStorePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="PalTR Mağaza" Style="{StaticResource DisplayTitle}" FontSize="31" />
                            <TextBlock Text="Sunucu deneyimini destekleyen paketler ve özel içerikler." Style="{StaticResource Caption}" Margin="0,6,0,20" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OrnatePanel}" Margin="0,0,14,0" ClipToBounds="True">
                                <Grid>
                                    <Rectangle Fill="{StaticResource OrnamentBrush}" Opacity="0.45" />
                                    <StackPanel VerticalAlignment="Center" Margin="12">
                                        <TextBlock Text="ÖNE ÇIKAN" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                                        <Image Source="Assets/paltr-logo.png" Height="150" Stretch="Uniform" Margin="0,22,0,12" />
                                        <TextBlock Text="Kurucu Paketi" Style="{StaticResource DisplayTitle}" FontSize="30" HorizontalAlignment="Center" />
                                        <TextBlock Text="Özel rozet, destekçi ünvanı ve gelecek kozmetik içeriklere erken erişim."
                                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="10,10" />
                                        <Button Content="YAKINDA" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="18,14,18,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OrnatePanel}" Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ÜYELİK" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="PalTR Plus" Style="{StaticResource DisplayTitle}" FontSize="25" Margin="0,10,0,8" />
                                    <TextBlock Text="Aylık topluluk ayrıcalıkları ve destekçi avantajları." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#607C663A" Margin="0,20" />
                                    <TextBlock Text="Yakında satışta" Foreground="{StaticResource GoldLightBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OrnatePanel}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="KOZMETİK" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Sezon Koleksiyonu" Style="{StaticResource DisplayTitle}" FontSize="25" Margin="0,10,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Sunucuya özel görsel içerikler ve sınırlı koleksiyonlar." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#607C663A" Margin="0,20" />
                                    <TextBlock Text="Yakında satışta" Foreground="{StaticResource GoldLightBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Hesap -->
                    <Grid Visibility="{Binding IsAccountPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OrnatePanel}" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Hesabım" Style="{StaticResource DisplayTitle}" FontSize="31" />
                                <Border Width="92" Height="92" CornerRadius="46" Background="#A50E5963" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" HorizontalAlignment="Left" Margin="0,24,0,16">
                                    <TextBlock Text="P" Style="{StaticResource DisplayTitle}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding AccountDisplayName}" Style="{StaticResource DisplayTitle}" FontSize="27" />
                                <TextBlock Text="{Binding Snapshot.Membership}" Foreground="{StaticResource GoldLightBrush}" Margin="0,4,0,18" />
                                <TextBlock Text="Kimlik doğrulama ve güvenlik seçenekleri gerçek API bağlantısından sonra gösterilecek." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OrnatePanel}">
                            <StackPanel>
                                <TextBlock Text="Hesap Yönetimi" Style="{StaticResource SectionTitle}" />
                                <Button Content="ŞİFRE VE GÜVENLİK" Style="{StaticResource SecondaryButton}" Margin="0,20,0,9" IsEnabled="False" />
                                <Button Content="BAĞLI OYUN HESAPLARI" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" IsEnabled="False" />
                                <Button Content="OTURUM GEÇMİŞİ" Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                <Button Content="OTURUMU KAPAT" Style="{StaticResource SecondaryButton}" Margin="0,22,0,0"
                                        Command="{Binding LogoutCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#EE071621" BorderBrush="#6BC9A25A" BorderThickness="0,1,0,0" CornerRadius="0,0,17,17">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock Text="PalTR Launcher  •  UI Demo" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- Giriş ve kayıt kapısı -->
    <Border Visibility="{Binding IsAuthenticationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Background="#FF030A0F" BorderBrush="#E0C9A25A" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Image Source="Assets/slider-diplomacy.png" Stretch="UniformToFill" Opacity="0.48" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C8030B11" Offset="0" />
                        <GradientStop Color="#E4071620" Offset="0.52" />
                        <GradientStop Color="#FC030A0F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{StaticResource OrnamentBrush}" Opacity="0.30" IsHitTestVisible="False" />

            <Grid Margin="38">
                <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/paltr-logo.png" Width="62" Height="62" Stretch="Uniform" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PALTR LAUNCHER" Style="{StaticResource DisplayTitle}" FontSize="27" />
                            <TextBlock Text="OYUN VE SUNUCU MERKEZİ" Style="{StaticResource Eyebrow}" Margin="2,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="—" Style="{StaticResource GhostButton}" Width="44" Height="40" Padding="0" Margin="0,0,7,0" Click="Minimize_OnClick" />
                        <Button Content="×" Style="{StaticResource SecondaryButton}" Width="44" Height="40" Padding="0"
                                Background="#C16E2D27" BorderBrush="#CE9C6D55" FontSize="18" Click="Close_OnClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="20,20,20,26">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="560"/></Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="42,0,80,0">
                        <TextBlock Text="PALTR DÜNYASINA HOŞ GELDİN" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Text="Tek hesapla bütün PalTR deneyimine katıl."
                                   Style="{StaticResource DisplayTitle}" FontSize="43" TextWrapping="Wrap" Margin="0,15,0,15" />
                        <TextBlock Text="Launcher, sunucu ve oyun içi sistemler için hazırlanan hesabınla giriş yap. Klan diplomasisi, destek talepleri, güncellemeler ve gelecekteki mağaza hizmetleri aynı kimlik altında birleşecek."
                                   Style="{StaticResource Caption}" FontSize="16" LineHeight="26" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                            <Border Style="{StaticResource SoftPanel}" Padding="15,10" Margin="0,0,10,0">
                                <TextBlock Text="●  Güvenli hesap altyapısı" Foreground="{StaticResource GoldLightBrush}" />
                            </Border>
                            <Border Style="{StaticResource SoftPanel}" Padding="15,10">
                                <TextBlock Text="●  Tek launcher, tek kimlik" Foreground="{StaticResource GoldLightBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F408151E" BorderBrush="#D0C9A25A" BorderThickness="1"
                            CornerRadius="14" Padding="38" Effect="{StaticResource DeepShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PalTR Hesabı" Style="{StaticResource DisplayTitle}" FontSize="31" />
                                <TextBlock Text="Devam etmek için giriş yap veya yeni hesabını oluştur." Style="{StaticResource Caption}" Margin="0,7,0,20" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton Content="GİRİŞ YAP" Style="{StaticResource AuthTab}" GroupName="AuthMode" Margin="0,0,5,0"
                                             IsChecked="{Binding IsLoginMode, Mode=OneWay}" Command="{Binding ShowLoginCommand}" />
                                <RadioButton Grid.Column="1" Content="KAYIT OL" Style="{StaticResource AuthTab}" GroupName="AuthMode" Margin="5,0,0,0"
                                             IsChecked="{Binding IsRegisterMode, Mode=OneWay}" Command="{Binding ShowRegisterCommand}" />
                            </Grid>

                            <Grid Grid.Row="2" Visibility="{Binding IsLoginMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Border Background="#A5102935" BorderBrush="#83705B36" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,0,0,17">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DEMO HESABI" Style="{StaticResource Eyebrow}" Foreground="{StaticResource CyanBrush}" />
                                                <TextBlock Margin="0,5,0,0"><Run Text="Kullanıcı adı: "/><Run Text="Herakles" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                <TextBlock Text="DEMO PAROLA" Style="{StaticResource Eyebrow}" />
                                                <TextBlock Text="PalTRDemo2026!" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="KULLANICI ADI" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextInput}" Text="{Binding LoginIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="PAROLA" Style="{StaticResource Eyebrow}" Margin="0,18,0,7" />
                                    <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource PasswordInput}" PasswordChanged="LoginPassword_OnPasswordChanged" />
                                    <Grid Margin="0,14,0,0">
                                        <CheckBox Content="Beni hatırla" Style="{StaticResource AuthCheckBox}"
                                                  IsChecked="{Binding RememberMe}" VerticalAlignment="Center" />
                                        <Button Content="PAROLAMI UNUTTUM" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="11,6" FontSize="11" IsEnabled="False" />
                                    </Grid>
                                    <Button Content="PALTR'YE GİRİŞ YAP" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Click="Login_OnClick" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2" Visibility="{Binding IsRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="KULLANICI ADI" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                                    <TextBox Style="{StaticResource AuthTextInput}" Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="E-POSTA" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                                    <TextBox Style="{StaticResource AuthTextInput}" Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="PAROLA" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                                            <PasswordBox x:Name="RegisterPasswordBox" Style="{StaticResource PasswordInput}" PasswordChanged="RegisterPassword_OnPasswordChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="PAROLA TEKRARI" Style="{StaticResource Eyebrow}" Margin="0,0,0,7" />
                                            <PasswordBox x:Name="RegisterPasswordConfirmationBox" Style="{StaticResource PasswordInput}" PasswordChanged="RegisterPasswordConfirmation_OnPasswordChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Style="{StaticResource AuthCheckBox}" IsChecked="{Binding HasAcceptedTerms}" Margin="0,18,0,0">
                                        <TextBlock Text="Kullanım koşullarını ve gizlilik politikasını kabul ediyorum." TextWrapping="Wrap" />
                                    </CheckBox>
                                    <Button Content="HESABIMI OLUŞTUR" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Click="Register_OnClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="3" Background="#A10B1B24" BorderBrush="#57786647" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,18,0,0">
                                <TextBlock Text="{Binding AuthenticationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticationMessageError}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFF9B83" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock Text="PalTR hesabı demo doğrulaması • Bilgiler uzak sunucuya gönderilmez"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="PALTR LAUNCHER  •  UI FAZ-00" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
