<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Ink">#050C12</Color>
    <Color x:Key="DeepNavy">#071722</Color>
    <Color x:Key="Navy">#0B2637</Color>
    <Color x:Key="NavyLift">#173D52</Color>
    <Color x:Key="Gold">#C9A25A</Color>
    <Color x:Key="GoldDim">#6F5832</Color>
    <Color x:Key="GoldLight">#E4C98F</Color>
    <Color x:Key="Teal">#0E6973</Color>
    <Color x:Key="Cyan">#37D6E5</Color>
    <Color x:Key="Parchment">#DCC18B</Color>
    <Color x:Key="TextPrimary">#F2E9D7</Color>
    <Color x:Key="TextMuted">#9EACB2</Color>
    <Color x:Key="Success">#61CF84</Color>
    <Color x:Key="Danger">#B34F3C</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}" />
    <SolidColorBrush x:Key="GoldDimBrush" Color="{StaticResource GoldDim}" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLight}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource Parchment}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

    <LinearGradientBrush x:Key="WindowSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F606121A" Offset="0" />
        <GradientStop Color="#F30A2231" Offset="0.52" />
        <GradientStop Color="#F7061119" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FC112E40" Offset="0" />
        <GradientStop Color="#FC071620" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarSurfaceBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FC020A10" Offset="0" />
        <GradientStop Color="#FA04131D" Offset="0.72" />
        <GradientStop Color="#F7071A25" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8173342" Offset="0" />
        <GradientStop Color="#E80B1A24" Offset="0.72" />
        <GradientStop Color="#F208131A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2143B52" Offset="0" />
        <GradientStop Color="#F40A2638" Offset="0.48" />
        <GradientStop Color="#FA07131C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ParchmentHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F1E0C99A" Offset="0" />
        <GradientStop Color="#E8B99254" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TealActionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF188A92" Offset="0" />
        <GradientStop Color="#FF0B5C68" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="OrnamentBrush" TileMode="Tile" Viewport="0,0,56,56" ViewportUnits="Absolute" Opacity="0.14">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H56 V56 H0 Z" />
                <GeometryDrawing Brush="Transparent" Geometry="M0,28 L28,0 M28,56 L56,28 M14,28 L28,14 L42,28 L28,42 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8DC9A25A" Thickness="0.7" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#342DB3BC" Geometry="M25,25 H31 V31 H25 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="DeepShadow" Color="#FF000000" BlurRadius="30" ShadowDepth="10" Opacity="0.72" />
    <DropShadowEffect x:Key="CardShadow" Color="#FF000000" BlurRadius="15" ShadowDepth="4" Opacity="0.52" />
    <DropShadowEffect x:Key="CyanGlow" Color="#FF2FE2EF" BlurRadius="18" ShadowDepth="0" Opacity="0.32" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFF2E3BD" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitle}">
        <Setter Property="FontSize" Value="21" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
    </Style>

    <Style x:Key="OrnatePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="#9AC9A25A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>
    <Style x:Key="SoftPanel" TargetType="Border">
        <Setter Property="Background" Value="#B5132834" />
        <Setter Property="BorderBrush" Value="#526C7B7C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="15" />
    </Style>
    <Style x:Key="ParchmentStrip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ParchmentHeaderBrush}" />
        <Setter Property="BorderBrush" Value="#B088683C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFF8F1DF" />
        <Setter Property="Background" Value="{StaticResource TealActionBrush}" />
        <Setter Property="BorderBrush" Value="#E13DD3DB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF168994" />
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource CyanGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#C51A2B34" />
        <Setter Property="BorderBrush" Value="#8BC9A25A" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#44182933" />
        <Setter Property="BorderBrush" Value="#496A7E85" />
    </Style>

    <Style x:Key="AccountShortcutButton" TargetType="Button">
        <Setter Property="Background" Value="#B5132834" />
        <Setter Property="BorderBrush" Value="#526C7B7C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="13">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D3183E4A" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#B9C9A25A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Height" Value="58" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="#D7D9D4C9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="#38172B35" BorderBrush="#3D70818A" BorderThickness="1"
                            CornerRadius="10" Padding="13,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="#7E0F3A48" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe UI Symbol" FontSize="15"
                                           Foreground="{StaticResource GoldLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{StaticResource CyanBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#8A153B48" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#A337D6E5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D20E5866" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource CyanGlow}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextInput" TargetType="TextBox">
        <Setter Property="Background" Value="#D308151D" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#7C7D673D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Background" Value="#E407141D" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#8C7D673D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style x:Key="AuthTextInput" TargetType="TextBox" BasedOn="{StaticResource TextInput}">
        <Setter Property="Background" Value="#E407141D" />
        <Setter Property="Padding" Value="13,11" />
    </Style>
    <Style x:Key="AuthTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="#66132935" BorderBrush="#557B6A43"
                            BorderThickness="1" CornerRadius="8" Padding="20,11">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#A1153B48" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D00E5866" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            <Setter Property="Foreground" Value="#FFF8F1DF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AuthCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#E207151D" BorderBrush="#B8A98758" BorderThickness="1" CornerRadius="4">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="14" FontWeight="Bold"
                                       Foreground="#FFB8F5E8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#FF0E6973" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF63DCE5" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
